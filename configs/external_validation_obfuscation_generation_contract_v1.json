{
  "contract_id": "external_validation_obfuscation_generation_contract_v1",
  "protocol_id": "safety_monitor_external_validation_preregistration_v1",
  "status": "frozen_precollection_component",
  "purpose": "Freeze the deterministic obfuscation-generation mechanism for F and SF before W0 without introducing any new attack families or adaptive selection.",
  "authoritative_registry": {
    "path": "configs/external_validation_attack_family_registry_v1.json",
    "registry_id": "external_validation_attack_family_registry_v1"
  },
  "cell_scope": {
    "F": "human-source obfuscated cell",
    "SF": "model-generated-source obfuscated cell"
  },
  "generation_rule": {
    "input": "canonical pre-obfuscation base prompt identified by base_intent_id",
    "exactly_one_transform_required": true,
    "transform_set": ["O1", "O2", "O3"],
    "selection_rule": "SHA256(base_intent_id) interpreted as an integer modulo 3, with transforms ordered O1,O2,O3",
    "manual_post_transform_editing_allowed": false,
    "adaptive_transform_selection_allowed": false,
    "monitor_output_based_selection_allowed": false,
    "target_response_based_selection_allowed": false,
    "transform_stacking_allowed": false
  },
  "transforms": {
    "O1": {
      "name": "character_separator",
      "definition_source": "external_validation_attack_family_registry_v1",
      "semantic_intent_change_allowed": false
    },
    "O2": {
      "name": "leet_substitution",
      "definition_source": "external_validation_attack_family_registry_v1",
      "semantic_intent_change_allowed": false
    },
    "O3": {
      "name": "base64_representation",
      "definition_source": "external_validation_attack_family_registry_v1",
      "semantic_intent_change_allowed": false
    }
  },
  "eligibility_and_provenance": {
    "base_intent_id_required": true,
    "template_id_required": true,
    "attack_family_id_required": true,
    "transform_id_required": true,
    "dependency_text_is_pre_obfuscation_text": true,
    "failed_or_invalid_transform_excluded_before_monitor_scoring": true,
    "historical_project_attack_examples_reused": false
  },
  "analysis_boundary": {
    "obfuscation_rule_frozen_before_W0": true,
    "transform_assignment_completed_before_monitor_scoring": true,
    "monitor_outputs_cannot_affect_transform_choice": true,
    "confirmation_domain_retuning_allowed": false
  },
  "freeze_rules": {
    "transform_set_immutable_after_W0_starts": true,
    "transform_definitions_immutable_after_W0_starts": true,
    "assignment_rule_immutable_after_W0_starts": true,
    "no_new_transform_added_after_W0_starts": true,
    "no_manual_rescue_of_failed_cells": true
  }
}
