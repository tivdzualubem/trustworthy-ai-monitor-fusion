  "decision_value": {
    "name": "policy_specific_signed_decision_value",
    "realized_definition": "V_pi=L(Y,pi_base(H))-L(Y,pi_augmented(H,Z))",
    "conditional_definition": "v_pi(h)=E[V_pi|H=h]",
    "zero_one_loss_values": [
      -1,
      0,
      1
    ],
    "negative_values_allowed": true,
    "policy_specific": true,
    "base_and_augmented_policies_must_be_frozen_within_each_outer_fold": true,
    "target_generation": "nested_cross_fitting_with_current_outer_evaluation_group_excluded",
    "net_value_rule": "acquire iff estimated_v_pi(h)-lambda*estimated_incremental_cost_ms(h)>0",
    "equivalent_positive_cost_score": "estimated_v_pi(h)/max(estimated_incremental_cost_ms(h),1.0)",
    "bayes_nonnegativity_claim_for_fitted_policies_forbidden": true
  },
  "development_resampling": {
    "splitter": "StratifiedGroupKFold",
    "outer_folds": 5,
    "inner_folds": 4,
    "shuffle": true,
    "fold_seeds": [
      1729,
      2718,
      3141,
      5772,
      8111
    ],
    "group_key_priority": [
      "group_id",
      "pair_id",
      "example_id"
    ],
    "stratification_target": "y",
    "selection_criterion": "mean_group_bootstrap_lower_confidence_bound_of_recall_at_jointly_feasible_exact_cost_points",
    "aggregation": "average each metric across seeds; uncertainty resamples effective groups and recomputes the across-seed mean",
    "minimum_stability_requirement": "primary recall difference has the same sign in at least four of five seeds"
  },
